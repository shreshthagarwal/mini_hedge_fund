# Copy to .env and fill in. .env is gitignored — never commit it.

# Upstox app credentials (developer console → your app)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must exactly match the redirect URL registered in the Upstox app
UPSTOX_REDIRECT_URI=http://127.0.0.1:5173/callback

# Optional: daily access token (otherwise read from .upstox_token)
# UPSTOX_ACCESS_TOKEN=

# Dashboard. On the server keep 127.0.0.1 — Cloudflare Tunnel connects locally.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5173

# 1 = allow the dashboard's manual LONG/SHORT/EXIT buttons. Keep 0 on a public URL.
ALLOW_MANUAL_TRADES=0

# Intelligence gate (macro/sentiment/regime). Untested in backtests and slow
# from cloud IPs — keep 0 until it is validated.
USE_INTEL_GATE=0
INTEL_REFRESH_SEC=300

# Days of 5-min history fetched from Upstox for indicator warmup
WARMUP_DAYS=10

# Trading charges (see src/costs.py) — verify against current rates
BROKERAGE_PER_ORDER=20
STT_FUTURES_RATE=0.0005

# Browser login via the public site; must match the Redirect URL in the
# Upstox app, e.g. https://<site>/auth/callback
UPSTOX_WEB_REDIRECT_URI=
